{
  "name": "patchworkpp-tutorial",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive Three.js walkthrough of the Patchwork++ LiDAR ground-segmentation algorithm",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.tests.json",
    "verify": "node --experimental-strip-types scripts/verify-port.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "wrangler deploy",
    "preview:cf": "pnpm run build && wrangler dev",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "preview:upload": "wrangler versions upload"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.135.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
